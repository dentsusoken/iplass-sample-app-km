{
  "name": "iplass-sample-app-km",
  "private": "true",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.spa.config.ts",
    "build:sample-app-frontend": "vue-tsc --noEmit && vite build --config vite.spa.config.ts",
    "lint": "eslint src/**/*.{ts,vue} -c src/main/vue/eslint.config.mjs --fix",
    "lint:check": "eslint src/**/*.{ts,vue} -c src/main/vue/eslint.config.mjs",
    "format": "prettier --write \"src/main/vue/**/*.{ts,vue}\" \"e2e/**/*.ts\" \"e2e-integration/**/*.ts\" --log-level warn",
    "format:check": "prettier --check \"src/main/vue/**/*.{ts,vue}\" \"e2e/**/*.ts\" \"e2e-integration/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "dompurify": "^3.4.7",
    "markdown-it": "^14.2.0",
    "pinia": "^3.0.0",
    "vue-i18n": "^11.4.5",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.52.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": ">=22",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.34.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^16.3.0",
    "happy-dom": "^18.0.1",
    "prettier": "^3.3.3",
    "typescript": "~5.9.2",
    "v-lazy-show": "^0.2.4",
    "vite": "^6.0.3",
    "vitest": "^3.2.1",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^3.0.6"
  },
  "engines": {
    "node": ">=22.x",
    "npm": ">=10.x"
  }
}
